{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["server/src/extraction/fixtures"],
  "plugins": ["import", "typescript", "unicorn"],
  "options": {
    "typeAware": true,
    "typeCheck": false
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": "error",
    "import/no-default-export": "error",
    "no-console": "error",
    "no-lonely-if": "error",
    "no-negated-condition": "error",
    "no-shadow": "error",
    "no-unused-vars": "error",
    "typescript/array-type": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/throw-new-error": "error"
  },
  "overrides": [
    {
      "files": ["client/**/*"],
      "rules": {
        "import/no-default-export": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@scran/server",
                "allowImportNames": ["AppType"],
                "message": "Only `import type { AppType }`. Importing a value from the server would put bun:sqlite in the browser bundle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["server/src/index.ts", "**/*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-console": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": [
        "client/src/api/recipes.ts",
        "client/src/screens/recipe.tsx",
        "scripts/**/*.ts"
      ],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}

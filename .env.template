# Required secrets — boot fails immediately without them.
OPENAI_API_KEY=

# Everything below defaults to the laptop layout; uncomment to override.
# Deployment sets DATA_DIR and DATABASE_URL absolutely.

# Where sources live (photos, fetched HTML). Bind-mounted in Docker.
# DATA_DIR=./data

# SQLite file. Bind-mounted in Docker, separately from DATA_DIR.
# DATABASE_URL=./data/scran.db

# OPENAI_MODEL=gpt-4.1

# trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# PORT=3000

# Origin the app is reached on. Vite uses 5173 locally; on the LAN set the
# container's address instead. Production requires an HTTPS origin (no trailing
# slash or path); Compose uses this override for a new public hostname.
# BASE_URL=https://recipes.example.com

# false on the LAN (http:// is not a secure context, so Secure cookies are
# silently dropped), true behind TLS. The whole TLS story, one variable.
# COOKIE_SECURE=false

# Generate randomly (at least 32 characters); do not store beside data backups.
AUTH_SECRET=

# Only trust the single-IP header overwritten by the isolated reverse proxy.
# Keep Bun loopback-only. See docs/security.md before introducing a CDN.
# AUTH_IP_HEADER=x-forwarded-for

# UTC-day admission limits; failed admitted attempts count. Not a dollar budget.
# MAX_EXTRACTIONS_PER_USER_DAY=60
# MAX_EXTRACTIONS_PER_DAY=200
# MAX_CONCURRENT_EXTRACTIONS=2
# MAX_STORED_SOURCE_BYTES=5368709120

# The only required variable — boot fails immediately without it.
OPENAI_API_KEY=

# Everything below defaults to the laptop layout; uncomment to override.
# Deployment sets DATA_DIR and DATABASE_URL absolutely.

# Where sources live (photos, fetched HTML). Bind-mounted in Docker.
# DATA_DIR=./data

# SQLite file. Bind-mounted in Docker, separately from DATA_DIR.
# DATABASE_URL=./data/scran.db

# OPENAI_MODEL=gpt-4.1

# trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# PORT=3000

# Origin the app is reached on. Vite uses 5173 locally; on the LAN set the
# container's address instead.
# BASE_URL=http://localhost:5173

# false on the LAN (http:// is not a secure context, so Secure cookies are
# silently dropped), true behind TLS. The whole TLS story, one variable.
# COOKIE_SECURE=false

AUTH_SECRET=

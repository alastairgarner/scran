{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "ignorePatterns": ["**/*.md", "server/src/extraction/fixtures"],
  "printWidth": 80,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": true,
  "overrides": [
    {
      "files": ["**/*.css"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}

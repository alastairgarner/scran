{
  "name": "scran",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "invite": "bun --env-file=.env server/src/cli/invite.ts",
    "test": "bun test",
    "check": "oxlint . && oxfmt --check . && bun scripts/check-theme.ts && bun run --filter '*' typecheck",
    "fix": "oxlint --fix . && oxfmt .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001"
  }
}
